# NetGoat CAS admin
#
# The panel proxies to the CAS API with CAS_API_KEY attached server-side, and
# is itself protected by HTTP Basic auth. Both are required.

# --- Panel auth (required) ---------------------------------------------------
# The middleware fails closed: with no password the panel returns 503.
CAS_ADMIN_USERNAME=admin
CAS_ADMIN_PASSWORD=

# --- CAS API -----------------------------------------------------------------
CAS_URL=http://127.0.0.1:8088
# Optional bearer key for the CAS API. Kept server-side; never sent to browsers.
CAS_API_KEY=
